{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSpacing": true,
  "printWidth": 80,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/*.tsbuildinfo"
  ],
  "sortImports": {
    "internalPattern": ["@fawn/"],
    "groups": [
      ["type-builtin", "value-builtin"],
      ["type-external", "value-external"],
      ["type-internal", "value-internal"],
      [
        "type-parent",
        "value-parent",
        "type-sibling",
        "value-sibling",
        "type-index",
        "value-index"
      ],
      "unknown"
    ],
    "newlinesBetween": true,
    "sortSideEffects": false
  }
}
